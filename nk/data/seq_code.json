"export default () => { const W = 230, H = 52, L = 190, R = 560, yB = 96, yD1 = 186, yBe = 286, yD2 = 376, yS = 470; const edge = 'var(--cds-chart-axis)', accent = 'var(--cds-chart-categorical-1)', ink = 'var(--cds-text-primary)', quiet = 'var(--cds-text-secondary)'; const box = (cx, cy, main) => <rect x={cx - W / 2} y={cy - H / 2} width={W} height={H} rx='8' fill={main ? accent : 'none'} fillOpacity={main ? 0.12 : 1} stroke={main ? accent : edge} strokeWidth={main ? 2 : 1.25}/>; const dia = (cx, cy) => <polygon points={`${cx - 70},${cy} ${cx},${cy - 32} ${cx + 70},${cy} ${cx},${cy + 32}`} fill='none' stroke={edge} strokeWidth='1.25'/>; return <svg viewBox='0 0 760 520' role='img' aria-label='Ohne Antwort folgt der Besuch, die Mail erst nach Einwilligung' fontSize='13'><defs><marker id='seq-arrow' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='6' markerHeight='6' orient='auto-start-reverse'><path d='M0 0L10 5L0 10z' fill={edge}/></marker></defs><text data-claude-text-id='title' x='24' y='34' fontSize='15' fontWeight='600' fill={ink}>Ohne Antwort folgt der Besuch, die Mail erst nach Einwilligung</text><g data-claude-anchor='connectors' fill='none' stroke={edge} strokeWidth='1.25'><path d={`M${L} ${yB + H / 2}V${yD1 - 32}`} markerEnd='url(#seq-arrow)'/><path d={`M${L + 70} ${yD1}H${R - W / 2}`} markerEnd='url(#seq-arrow)'/><path d={`M${L} ${yD1 + 32}V${yBe - H / 2}`} markerEnd='url(#seq-arrow)'/><path d={`M${L} ${yBe + H / 2}V${yD2 - 32}`} markerEnd='url(#seq-arrow)'/><path d={`M${L + 70} ${yD2}H400V240H480V${yD1 + H / 2}`} markerEnd='url(#seq-arrow)'/><path d={`M${L} ${yD2 + 32}V${yS - H / 2}`} markerEnd='url(#seq-arrow)'/><path d={`M${R} ${yD1 + H / 2}V${yBe - H / 2}`} markerEnd='url(#seq-arrow)'/><path d={`M${R} ${yBe + H / 2}V${yD2 - H / 2}`} markerEnd='url(#seq-arrow)'/><path d={`M${R} ${yD2 + H / 2}V${yS - H / 2}`} markerEnd='url(#seq-arrow)'/></g><g data-claude-anchor='step-brief'>{box(L, yB, false)}<text data-claude-text-id='brief' x={L} y={yB - 4} textAnchor='middle' fontWeight='600' fill={ink}>Brief B1, B2 oder B3</text><text data-claude-text-id='brief-sub' x={L} y={yB + 14} textAnchor='middle' fontSize='11.5' fill={quiet}>Tag 0, Erstkontakt</text></g><g data-claude-anchor='decision-reaktion'>{dia(L, yD1)}<text data-claude-text-id='reaktion' x={L} y={yD1 + 4} textAnchor='middle' fill={ink}>Reaktion?</text></g><g data-claude-anchor='step-besuch'>{box(L, yBe, false)}<text data-claude-text-id='besuch' x={L} y={yBe - 4} textAnchor='middle' fontWeight='600' fill={ink}>Besuch im Laden</text><text data-claude-text-id='besuch-sub' x={L} y={yBe + 14} textAnchor='middle' fontSize='11.5' fill={quiet}>nach 5 Werktagen</text></g><g data-claude-anchor='decision-einwilligung'>{dia(L, yD2)}<text data-claude-text-id='einwilligung' x={L} y={yD2 + 4} textAnchor='middle' fill={ink}>Einwilligung?</text></g><g data-claude-anchor='step-spaeter'>{box(L, yS, false)}<text data-claude-text-id='spaeter' x={L} y={yS - 4} textAnchor='middle' fontWeight='600' fill={ink}>Status: Später</text><text data-claude-text-id='spaeter-sub' x={L} y={yS + 14} textAnchor='middle' fontSize='11.5' fill={quiet}>in 3 Monaten neu prüfen</text></g><g data-claude-anchor='step-vorschau'>{box(R, yD1, true)}<text data-claude-text-id='vorschau' x={R} y={yD1 - 4} textAnchor='middle' fontWeight='600' fill={ink}>Vorschau senden</text><text data-claude-text-id='vorschau-sub' x={R} y={yD1 + 14} textAnchor='middle' fontSize='11.5' fill={quiet}>M2, M1 oder W1, am selben Tag</text></g><g data-claude-anchor='step-nachfassen'>{box(R, yBe, false)}<text data-claude-text-id='nachfassen' x={R} y={yBe - 4} textAnchor='middle' fontWeight='600' fill={ink}>Nachfassen</text><text data-claude-text-id='nachfassen-sub' x={R} y={yBe + 14} textAnchor='middle' fontSize='11.5' fill={quiet}>F1 Tag 3 · F2 Tag 7 · F3 Tag 14</text></g><g data-claude-anchor='step-termin'>{box(R, yD2, false)}<text data-claude-text-id='termin' x={R} y={yD2 - 4} textAnchor='middle' fontWeight='600' fill={ink}>Termin und Angebot</text><text data-claude-text-id='termin-sub' x={R} y={yD2 + 14} textAnchor='middle' fontSize='11.5' fill={quiet}>A1, Zahlung 50 % und 50 %</text></g><g data-claude-anchor='step-auftrag'>{box(R, yS, false)}<text data-claude-text-id='auftrag' x={R} y={yS - 4} textAnchor='middle' fontWeight='600' fill={ink}>Auftrag und Livegang</text><text data-claude-text-id='auftrag-sub' x={R} y={yS + 14} textAnchor='middle' fontSize='11.5' fill={quiet}>R1: Bewertung und Empfehlung</text></g><text data-claude-text-id='ja-1' x={L + 86} y={yD1 - 8} fontSize='11.5' fill={quiet}>ja</text><text data-claude-text-id='nein-1' x={L + 10} y={yD1 + 56} fontSize='11.5' fill={quiet}>nein</text><text data-claude-text-id='ja-2' x={L + 86} y={yD2 - 8} fontSize='11.5' fill={quiet}>ja, im Gespräch</text><text data-claude-text-id='nein-2' x={L + 10} y={yD2 + 56} fontSize='11.5' fill={quiet}>nein</text><text data-claude-text-id='antwort' x={R + 10} y={yD2 - 38} fontSize='11.5' fill={quiet}>Antwort 1 oder Termin</text></svg>; };"